From: TB321FU local integration
Subject: [PATCH] drm/panel: backport TB321FU BOE support to 7.1.1

BOE init sequence, modes and descriptor by enij90, adapted from
armada-tb321fu/packages/kernel/patches/0803-drm-panel-nt36523-add-lenovo-kirby-csot-boe.patch
(blob c39dd355b89dd0b0b6947fb817e16d5ed2caf85d, GPL-2.0-only).
Keep the 7.1.1 driver API and CSOT support. Select BOE in this device DT.
Not yet compiled or tested on hardware.

--- a/drivers/gpu/drm/panel/panel-novatek-nt36523.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt36523.c
@@ -1398,6 +1398,107 @@
 	.display_on_after_dsc = true,
 };
 
+static int kirby_boe_init_sequence(struct panel_info *pinfo)
+{
+	struct mipi_dsi_device *dsi0 = pinfo->dsi[0];
+	struct mipi_dsi_device *dsi1 = pinfo->dsi[1];
+
+	/* Lenovo TB321FU Android qcom,mdss_dsi_kirby_nt36523_boe_dsc_vid */
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0xff, 0x10);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0xfb, 0x01);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0xf0, 0xaa);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0xf1, 0x55);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0xf2, 0x99);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0xff, 0x25);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0x0f, 0x20);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0xff, 0x27);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0xfb, 0x01);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0xd0, 0x01);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0xd1, 0x54);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0xde, 0x03);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0xdf, 0x02);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0xff, 0xd0);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0xfb, 0x01);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0x00, 0x30);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0x09, 0xee);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0x1c, 0x99);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0x1d, 0x09);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0xff, 0xf0);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0xfb, 0x01);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0x24, 0x02);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0xff, 0x25);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0xfb, 0x01);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0x17, 0xcf);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0x19, 0x1f);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0x1b, 0x5b);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0xff, 0x10);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0xfb, 0x01);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0x35, 0x00);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0x3b, 0x03, 0x04, 0x1e, 0x04, 0x04, 0x01);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0x51, 0x0f, 0xff);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0x53, 0x2c);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0x55, 0x00);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0x90, 0x03);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0x91, 0x89, 0x28, 0x00, 0x14, 0xc2, 0x00, 0x02, 0x91, 0x02, 0x47, 0x00, 0x0b, 0x05, 0x0e, 0x03, 0x68);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0x92, 0x10, 0xe0);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0xb2, 0x91);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0xb3, 0x01);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0xbb, 0x13);
+	mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, 0x11);
+	msleep(105);
+
+	return 0;
+}
+
+static const struct drm_display_mode kirby_boe_modes[] = {
+	{
+		/* BOE 120Hz baseline (stock nt36523 boe fhd plus 165Hz CPHY video, 120Hz timing) */
+		.clock = 791388,
+		.hdisplay = 1600,
+		.hsync_start = 1600 + 566,
+		.hsync_end = 1600 + 566 + 40,
+		.htotal = 1600 + 566 + 40 + 108,
+		.vdisplay = 2560,
+		.vsync_start = 2560 + 30,
+		.vsync_end = 2560 + 30 + 2,
+		.vtotal = 2560 + 30 + 2 + 258,
+	},
+	{
+		/* dynamic-FPS porch mode (extended VFP), same link clock */
+		.clock = 791388,
+		.hdisplay = 1600,
+		.hsync_start = 1600 + 566,
+		.hsync_end = 1600 + 566 + 40,
+		.htotal = 1600 + 566 + 40 + 108,
+		.vdisplay = 2560,
+		.vsync_start = 2560 + 2880,
+		.vsync_end = 2560 + 2880 + 2,
+		.vtotal = 2560 + 2880 + 2 + 258,
+	},
+};
+
+static const struct panel_desc kirby_boe_desc = {
+	.modes = kirby_boe_modes,
+	.num_modes = ARRAY_SIZE(kirby_boe_modes),
+	.dsi_info = {
+		.type = "nt36523-kirby-boe",
+		.channel = 0,
+		.node = NULL,
+	},
+	.width_mm = 118,
+	.height_mm = 190,
+	.bpc = 8,
+	.lanes = 3,
+	.format = MIPI_DSI_FMT_RGB888,
+	.mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+		      MIPI_DSI_MODE_NO_EOT_PACKET |
+		      MIPI_DSI_CLOCK_NON_CONTINUOUS | MIPI_DSI_MODE_LPM,
+	.init_sequence = kirby_boe_init_sequence,
+	.is_dual_dsi = true,
+	.has_dsc = true,
+	.display_on_after_dsc = true,	/* reuses kirby_csot_display_on_sequence (identical) */
+};
+
 static const struct panel_desc j606f_boe_desc = {
 	.modes = j606f_boe_modes,
 	.num_modes = ARRAY_SIZE(j606f_boe_modes),
@@ -1811,6 +1912,22 @@
 
 static const struct of_device_id nt36523_of_match[] = {
 	{
+		.compatible = "lenovo,tb321fu-kirby-nt36523-boe-dsc-vid",
+		.data = &kirby_boe_desc,
+	},
+	{
+		.compatible = "lenovo,kirby-nt36523-boe-dsc-vid",
+		.data = &kirby_boe_desc,
+	},
+	{
+		.compatible = "lenovo,tb321fu-kirby-nt36523-boe-dsc",
+		.data = &kirby_boe_desc,
+	},
+	{
+		.compatible = "lenovo,kirby-nt36523-boe-dsc",
+		.data = &kirby_boe_desc,
+	},
+	{
 		.compatible = "lenovo,tb321fu-kirby-nt36523-csot-dsc-vid",
 		.data = &kirby_csot_desc,
 	},
--- a/arch/arm64/boot/dts/qcom/sm8650-lenovo-tb321fu.dts
+++ b/arch/arm64/boot/dts/qcom/sm8650-lenovo-tb321fu.dts
@@ -963,12 +963,12 @@
 	status = "okay";
 
 	display_panel: panel@0 {
-		compatible = "lenovo,tb321fu-kirby-nt36523-csot-dsc-vid",
-			     "lenovo,kirby-nt36523-csot-dsc-vid",
-			     "lenovo,tb321fu-kirby-nt36523-csot-dsc",
-			     "lenovo,kirby-nt36523-csot-dsc";
+		compatible = "lenovo,tb321fu-kirby-nt36523-boe-dsc-vid",
+			     "lenovo,kirby-nt36523-boe-dsc-vid",
+			     "lenovo,tb321fu-kirby-nt36523-boe-dsc",
+			     "lenovo,kirby-nt36523-boe-dsc";
 		reg = <0>;
-		panel-name = "kirby_nt36523_csot_dsc_vid";
+		panel-name = "kirby_nt36523_boe_dsc_vid";
 		vddio-supply = <&panel_iovdd>;
 		enp-supply = <&panel_enp>;
 		enn-supply = <&panel_enn>;
@@ -1220,7 +1220,7 @@
 		touchscreen-size-x = <1600>;
 		touchscreen-size-y = <2560>;
 
-		firmware-name = "qcom/sm8650/lenovo/tb321fu/novatek_ts_csot_fw.bin";
+		firmware-name = "qcom/sm8650/lenovo/tb321fu/novatek_ts_boe_fw.bin";
 		panel = <&display_panel>;
 
 		pinctrl-names = "default";
